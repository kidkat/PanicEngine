<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <Version>0.0.1</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.1</FileVersion>
    
    <Authors>kidkat</Authors>
    <Company>kidkat</Company>
    <Description>PanicEngine - A physics engine library</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- <RepositoryUrl>https://github.com/kidkat/PanicEngine</RepositoryUrl> -->
    <PackageTags>physics;unity;game-engine</PackageTags>
    <PackageId>PanicEngine</PackageId>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../out</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Adaptor\**" />
    <EmbeddedResource Remove="Adaptor\**" />
    <None Remove="Adaptor\**" />
  </ItemGroup>

</Project>
